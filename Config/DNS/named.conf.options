options {
    directory "/var/cache/bind";

    recursion yes;

    allow-query {
        localhost;
        192.168.1.0/24;
        172.26.44.0/24;
        172.26.46.0/24;
        172.16.0.0/24;
    };

    allow-recursion {
        localhost;
        192.168.1.0/24;
        172.26.44.0/24;
        172.26.46.0/24;
        172.16.0.0/24;
    };

    listen-on { any; };
    listen-on-v6 { any; };
};
